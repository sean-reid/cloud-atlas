{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-atlas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "cloud-atlas.dwainosaur.com", "custom_domain": true }],
  // On the hour the Worker dispatches the ingest workflow; GitHub's own schedule drifts by hours.
  "triggers": { "crons": ["0 * * * *"] },
  "ratelimits": [
    { "name": "API_RATE", "namespace_id": "1", "simple": { "limit": 300, "period": 60 } },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-atlas",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // The e2e suite issues a few hundred API requests a minute from one address, which is the
  // production budget; the local server for it gets a wider one. Bindings do not inherit.
  "env": {
    "e2e": {
      "routes": [],
      "ratelimits": [
        { "name": "API_RATE", "namespace_id": "1", "simple": { "limit": 3000, "period": 60 } },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloud-atlas",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
