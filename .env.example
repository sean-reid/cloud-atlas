# Nothing is required for local use. The site, the API, and the ingestion CLI
# run against a local D1 database with no credentials.

# Optional, for `npm run ingest -- --remote` and the deploy workflow.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional, read-only account credentials for the availability probes that need one.
# An adapter runs only when every variable it names is set; otherwise it reports as waiting.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GCP_PROJECT=
# GCP_SERVICE_ACCOUNT_JSON=
# OCI_TENANCY=
# OCI_USER=
# OCI_FINGERPRINT=
# OCI_PRIVATE_KEY=
# OCI_REGION=
# ALIBABA_ACCESS_KEY_ID=
# ALIBABA_ACCESS_KEY_SECRET=
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
